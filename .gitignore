# Sistema operacional
.DS_Store
Thumbs.db

# Editores
.vscode/
.idea/

# Claude Code (sessões locais, não devem ir pro repo)
.claude/projects/
.claude/sessions/
.claude/shell-snapshots/
.claude/telemetry/
.claude/file-history/
.claude/backups/

# Dependências
node_modules/

# Arquivos temporários
*.log
*.tmp

# Drop zone do usuário (só o README vai versionado)
dados/*
!dados/README.md

# Mídia original dos clientes (arquivos brutos, pesados demais pro Git).
# A versão comprimida que o site usa fica em clientes/<nome>/site/ e vai versionada.
clientes/*/midia-original/

# Token do Netlify (nunca versionar)
.claude/.netlify-token

# Local Netlify folder
.netlify

# clasp (Apps Script CLI): o token e o scriptId ficam presos à conta do
# cliente. O .deployment-id NÃO entra aqui: ele é o endereço público do
# App da Web (o mesmo pedaço que já aparece na URL do site), e versionar
# é o que garante que toda máquina atualize o mesmo deployment em vez de
# criar um novo.
.clasprc.json
**/.clasp.json
